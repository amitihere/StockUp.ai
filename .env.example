# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockpilot?schema=public"

# Channel3 API Key (Required for live product search & supplier discovery)
# Sign up at https://trychannel3.com to get an API key
CHANNEL3_API_KEY="your_channel3_api_key_here"

# AI Provider: "gemini" (default) or "openai"
AI_PROVIDER="gemini"

# Google Gemini API Key (Required if AI_PROVIDER="gemini")
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI API Key (Required if AI_PROVIDER="openai", optional otherwise)
OPENAI_API_KEY="your_openai_api_key_here"

# PayPal Sandbox Credentials (Required for Part 3 Payments)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_ENV="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"

